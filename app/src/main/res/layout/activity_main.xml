<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#3C1DB8"
        android:padding="10dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="55px"
            android:textColor="@color/white"
            android:text="Kalkulator Podróży"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="30px"
            android:textColor="@color/white"
            android:text="Autor: 00000000000"
            android:textAlignment="textEnd"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dystans w km"
            android:textSize="40px"/>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dystans w km"
            android:textSize="40px"
            android:layout_marginBottom="10dp"
            android:id="@+id/DysKm"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zużycie paliwa na 100km"
            android:textSize="40px"/>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Zużycie paliwa na 100km"
            android:textSize="40px"
            android:id="@+id/ZuzNakm"/>

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:id="@+id/Rgroup">
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Benzyna (6,50 zł/l)"
                android:textSize="35px"
                android:id="@+id/Benzine"/>
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diesel (6,70 zł/l)"
                android:textSize="35px"
                android:id="@+id/Diesel"/>
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LPG (3,10 zł/l)"
                android:textSize="35px"
                android:id="@+id/Lpg"/>
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liczba pasażerów"
            android:textSize="40px" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Liczba pasażerów"
            android:textSize="40px"
            android:id="@+id/Lpasaz"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OBLICZ KOSZT"
            android:layout_margin="10dp"
            android:id="@+id/Btn"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/black"
            android:padding="2dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAlignment="center"
                android:textColor="#008000"
                android:background="@color/white"
                android:id="@+id/CalKoszt"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAlignment="center"
                android:textColor="#008000"
                android:background="@color/white"
                android:id="@+id/NaOsob"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>